import 'dart:convert';
import 'dart:typed_data';

import 'package:cryptography/cryptography.dart';

class PasswordOptions {
  const PasswordOptions({
    this.uppercase = true,
    this.lowercase = true,
    this.numbers = true,
    this.symbols = true,
  });

  final bool uppercase;
  final bool lowercase;
  final bool numbers;
  final bool symbols;

  bool get isDefault => uppercase && lowercase && numbers && symbols;

  String get fingerprint =>
      'u${uppercase ? 1 : 0}l${lowercase ? 1 : 0}n${numbers ? 1 : 0}s${symbols ? 1 : 0}';
}

/// Deterministic, offline password derivation and formatting.
///
/// Changing the version or derivation constants creates a different scheme.
/// Retain these values to keep existing passwords reproducible.
class PasswordGenerator {
  static const algorithmVersion = 'v1';
  static const _derivationDomain = 'dpm-v1';
  static const _iterations = 310000;
  static const _upper = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
  static const _lower = 'abcdefghijkmnopqrstuvwxyz';
  static const _digits = '23456789';
  static const _symbols = '!@#%+=?_-';

  /// Derives a password that includes every selected character set.
  /// The same inputs and options always produce the same result.
  Future<String> generate({
    required String masterPassword,
    required String site,
    required int counter,
    required int length,
    required PasswordOptions options,
  }) async {
    if (masterPassword.isEmpty) {
      throw ArgumentError.value(
        masterPassword,
        'masterPassword',
        'Cannot be empty.',
      );
    }
    if (site.trim().isEmpty) {
      throw ArgumentError.value(site, 'site', 'Cannot be empty.');
    }
    if (counter < 1) {
      throw ArgumentError.value(counter, 'counter', 'Must be at least 1.');
    }
    if (length < 12 || length > 32) {
      throw ArgumentError.value(
        length,
        'length',
        'Must be between 12 and 32.',
      );
    }

    final groups = _enabledGroups(options);
    if (groups.isEmpty) {
      throw ArgumentError('Select at least one character set.');
    }

    final normalizedSite = normalizeSite(site);
    // Preserve the original v1 result for the default character sets. Custom
    // settings become part of the salt, so they can be reproduced exactly.
    final customOptions = options.isDefault ? '' : '|${options.fingerprint}';
    final salt = utf8.encode(
      '$_derivationDomain|$normalizedSite|$counter$customOptions',
    );
    final algorithm = Pbkdf2(
      macAlgorithm: Hmac.sha256(),
      iterations: _iterations,
      bits: 512,
    );
    final key = await algorithm.deriveKey(
      secretKey: SecretKey(utf8.encode(masterPassword)),
      nonce: salt,
    );
    return _format(await key.extractBytes(), length, groups);
  }

  /// Produces a stable service or device label.
  static String normalizeSite(String value) {
    var site = value.trim().toLowerCase();
    site = site.replaceFirst(RegExp(r'^https?://'), '');
    site = site.replaceFirst(RegExp(r'^www\\.'), '');
    return site.replaceFirst(RegExp(r'/.*$'), '');
  }

  List<String> _enabledGroups(PasswordOptions options) => [
        if (options.uppercase) _upper,
        if (options.lowercase) _lower,
        if (options.numbers) _digits,
        if (options.symbols) _symbols,
      ];

  String _format(List<int> bytes, int length, List<String> groups) {
    final random = _ByteReader(Uint8List.fromList(bytes));
    final alphabet = groups.join();
    final chars = <String>[for (final group in groups) _pick(group, random)];
    while (chars.length < length) {
      chars.add(_pick(alphabet, random));
    }

    // Fisher–Yates prevents the required character sets from having fixed
    // positions in the password.
    for (var i = chars.length - 1; i > 0; i--) {
      final j = random.nextInt(i + 1);
      final item = chars[i];
      chars[i] = chars[j];
      chars[j] = item;
    }
    return chars.join();
  }

  String _pick(String alphabet, _ByteReader random) =>
      alphabet[random.nextInt(alphabet.length)];
}

/// Reads deterministic values without modulo bias.
class _ByteReader {
  _ByteReader(this._bytes);

  final Uint8List _bytes;
  int _index = 0;

  int nextInt(int max) {
    final limit = 256 - (256 % max);
    while (true) {
      final value = _bytes[_index++ % _bytes.length];
      if (value < limit) return value % max;
    }
  }
}
